# --- Telegram Business Bot ---
# Получить у @BotFather в Telegram: /newbot -> скопировать токен
BOT_TOKEN=123456:AAAA-your-bot-token-here

# --- Gemini ---
# Бесплатный ключ: https://aistudio.google.com/apikey
GEMINI_API_KEY=AQ.Ab8RN6ImZ7cUC1PmBmusD9QkfUaNsNnLXp4PGwvHrr4yvQ7zYA
GEMINI_MODEL=gemini-2.5-flash

# Прокси для доступа к Gemini API (нужен, если он у тебя не открывается напрямую)
# Формат: http://user:pass@host:port  или  socks5://user:pass@host:port
PROXY_URL=

# Макс. длина ответа модели в токенах
MAX_OUTPUT_TOKENS=8192

# --- Поведение бота (можно менять на лету командами .setdelay / .setthreshold) ---
REPLY_DELAY_MIN=8
REPLY_DELAY_MAX=45
INACTIVITY_THRESHOLD_MIN=15

# Имя, от лица которого отвечает бот (можно сменить на лету: .setpersona <имя>)
PERSONA_NAME=Лерекай
